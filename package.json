{
  "name": "vivaci",
  "private": true,
  "scripts": {
    "build:css": "python3 scripts/bundle-vivaci-css.py",
    "sync:public": "VIVACI_PUBLIC_DIR=content-admin/public VIVACI_SKIP_LOCALE_SYNC=1 python3 scripts/vercel-build.py",
    "dev": "npm run build:css && npm run dev --prefix content-admin",
    "dev:legacy": "npm run build:css && python3 scripts/dev-server.py",
    "dev:admin": "npm run dev --prefix content-admin"
  }
}
