{
  "name": "vivaci-content-admin",
  "version": "0.1.0",
  "private": true,
  "description": "Vivaci treatment-page CMS built with Next.js and shadcn/ui.",
  "scripts": {
    "predev": "cd .. && npm run sync:public",
    "dev": "node ../scripts/print-dev-url.mjs && next dev --webpack -p ${PORT:-4000}",
    "build": "next build",
    "build:vivaci-static": "cd .. && VIVACI_PUBLIC_DIR=content-admin/public python3 scripts/vercel-build.py",
    "start": "next start -p 4000",
    "lint": "eslint ."
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-virtual": "^3.14.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "jose": "^6.2.17",
    "lucide-react": "^1.55.0",
    "next": "^16.2.9",
    "next-intl": "^4.13.7",
    "next-themes": "^0.4.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.9",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3"
  }
}
